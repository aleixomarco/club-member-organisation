# Supabase Project URL, z. B. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlicher Publishable Key (oder vorhandener anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur für spätere Server-Funktionen. Niemals mit NEXT_PUBLIC_ benennen.
# SUPABASE_SECRET_KEY=

# PayPal nur serverseitig, ausschliesslich fuer die Web-Version. In der
# nativen App wird PayPal bewusst nicht geladen — Apple untersagt in
# Richtlinie 3.1.1 jeden Kaufweg am In-App-Kauf vorbei.
#
# Zuerst Sandbox, dann live. Steht ENVIRONMENT auf sandbox, fliesst kein
# echtes Geld, auch wenn alle Kennungen gesetzt sind.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Je Stufe ein Plan. Fehlt ein Paar, entfaellt nur diese Stufe — die anderen
# funktionieren weiter (siehe app/api/paypal/config/route.ts).
PAYPAL_CLUB_BASIC_MONTHLY_PLAN_ID=
PAYPAL_CLUB_BASIC_YEARLY_PLAN_ID=
PAYPAL_CLUB_PLUS_MONTHLY_PLAN_ID=
PAYPAL_CLUB_PLUS_YEARLY_PLAN_ID=
PAYPAL_CLUB_PRO_MONTHLY_PLAN_ID=
PAYPAL_CLUB_PRO_YEARLY_PLAN_ID=
# Altbestand: nicht mehr verkauft, aber laufende Abos muessen zuordenbar und
# kuendbar bleiben. Nur setzen, wenn es solche Abos gibt.
PAYPAL_CLUB_PREMIUM_MONTHLY_PLAN_ID=
PAYPAL_MEMBER_MONTHLY_PLAN_ID=
PAYPAL_MEMBER_YEARLY_PLAN_ID=

# RevenueCat: Vereinsabo über native In-App-Käufe auf iOS/Android (PayPal
# bleibt für Web). Öffentliche Keys (safe für den Client, aus RevenueCat
# Project Settings → API Keys → Public app-specific key):
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
# Geheimer Webhook-Secret (RevenueCat → Project Settings → Integrations →
# Webhooks → Authorization Header). Nur serverseitig, niemals NEXT_PUBLIC_.
REVENUECAT_WEBHOOK_SECRET=
# Produkt-IDs müssen in App Store Connect / Play Console exakt so angelegt
# werden (siehe subscription_plans.code in Supabase):
#   club_basic_monthly, club_basic_yearly, club_premium_monthly, club_premium_yearly

# Pflichtangaben für Datenschutz und Impressum
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
# Vertretungsberechtigte Person (§5 TMG/DDG Pflichtangabe bei Vereinen/Gesellschaften, z. B. "Vorname Nachname, 1. Vorsitzender")
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
# Telefonnummer für schnelle elektronische Kontaktaufnahme (nach EuGH/BGH-Rechtsprechung neben E-Mail empfohlen/erforderlich)
NEXT_PUBLIC_LEGAL_PHONE=
# Vereinsregisternummer + Registergericht, falls eingetragener Verein (z. B. "VR 1234, Amtsgericht Iserlohn"). Sonst leer lassen.
NEXT_PUBLIC_LEGAL_REGISTER=
# Umsatzsteuer-ID nach §27a UStG, falls vorhanden. Sonst leer lassen.
NEXT_PUBLIC_LEGAL_VAT_ID=

# Nach Veröffentlichung der nativen Apps ergänzen
NEXT_PUBLIC_APP_STORE_REVIEW_URL=
NEXT_PUBLIC_PLAY_STORE_REVIEW_URL=
