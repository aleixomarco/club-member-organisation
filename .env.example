# Supabase Project URL, z. B. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlicher Publishable Key (oder vorhandener anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dienstschlüssel. PFLICHT, nicht optional: Ohne ihn sind die Kontolöschung,
# der Kalender-Feed, der Anfrage-Endpunkt der Website und die gesamte
# Betreiber-Oberfläche tot. Niemals mit NEXT_PUBLIC_ benennen — er umgeht jede
# Sicherheitsregel.
SUPABASE_SECRET_KEY=

# Zugang zur Betreiber-Oberfläche unter /betreiber. Nur für Production setzen,
# nicht für Preview: Ein Preview zeigt auf dieselbe Datenbank, und seine
# Adressen sind öffentlich erreichbar. Fehlt eines von beiden, ist die
# Oberfläche abgeschaltet statt ungeschützt.
# Passwort mindestens 16 Zeichen, Geheimnis mindestens 32 (openssl rand -hex 32).
BETREIBER_PASSWORT=
BETREIBER_SESSION_SECRET=

# In der App wird nichts verkauft (Stand 31.08.2026). Der Verein fragt den
# Vollzugang an, der Betreiber stellt eine Rechnung und schaltet mit
# verein_freischalten() frei. RevenueCat und PayPal sind ausgebaut - falls in
# einer bestehenden Umgebung noch NEXT_PUBLIC_REVENUECAT_*, REVENUECAT_WEBHOOK_SECRET
# oder PAYPAL_* gesetzt sind, koennen sie geloescht werden.

# Gemeinsamer Schluessel fuer das Anfrageformular auf der Website. Das Formular
# schickt ihn als "Authorization: Bearer ..." oder "X-Anfrage-Schluessel" an
# /api/vereinsanfrage. Nur serverseitig, niemals NEXT_PUBLIC_ und niemals im
# Seitenquelltext der Website.
WEBSITE_ANFRAGE_SECRET=

# Pflichtangaben für Datenschutz und Impressum
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
# Vertretungsberechtigte Person (§5 TMG/DDG Pflichtangabe bei Vereinen/Gesellschaften, z. B. "Vorname Nachname, 1. Vorsitzender")
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
# Telefonnummer für schnelle elektronische Kontaktaufnahme (nach EuGH/BGH-Rechtsprechung neben E-Mail empfohlen/erforderlich)
NEXT_PUBLIC_LEGAL_PHONE=
# Vereinsregisternummer + Registergericht, falls eingetragener Verein (z. B. "VR 1234, Amtsgericht Iserlohn"). Sonst leer lassen.
NEXT_PUBLIC_LEGAL_REGISTER=
# Umsatzsteuer-ID nach §27a UStG, falls vorhanden. Sonst leer lassen.
NEXT_PUBLIC_LEGAL_VAT_ID=

# Nach Veröffentlichung der nativen Apps ergänzen.
# Die ersten beiden verlinken den Store von der Browserseite aus; fehlen sie,
# steht dort nur "Die App wird gerade veröffentlicht". Die beiden REVIEW-Links
# schalten die Bewertungskacheln im Profil frei.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_REVIEW_URL=
NEXT_PUBLIC_PLAY_STORE_REVIEW_URL=
