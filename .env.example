# Supabase Project URL, z. B. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlicher Publishable Key (oder vorhandener anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur für spätere Server-Funktionen. Niemals mit NEXT_PUBLIC_ benennen.
# SUPABASE_SECRET_KEY=

# PayPal nur serverseitig. Zuerst Sandbox, später live.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MONTHLY_PLAN_ID=
PAYPAL_YEARLY_PLAN_ID=
PAYPAL_CLUB_MONTHLY_PLAN_ID=
PAYPAL_CLUB_YEARLY_PLAN_ID=

# Pflichtangaben für Datenschutz und Impressum
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
# Vertretungsberechtigte Person (§5 TMG/DDG Pflichtangabe bei Vereinen/Gesellschaften, z. B. "Vorname Nachname, 1. Vorsitzender")
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
# Telefonnummer für schnelle elektronische Kontaktaufnahme (nach EuGH/BGH-Rechtsprechung neben E-Mail empfohlen/erforderlich)
NEXT_PUBLIC_LEGAL_PHONE=
# Vereinsregisternummer + Registergericht, falls eingetragener Verein (z. B. "VR 1234, Amtsgericht Iserlohn"). Sonst leer lassen.
NEXT_PUBLIC_LEGAL_REGISTER=
# Umsatzsteuer-ID nach §27a UStG, falls vorhanden. Sonst leer lassen.
NEXT_PUBLIC_LEGAL_VAT_ID=

# Nach Veröffentlichung der nativen Apps ergänzen
NEXT_PUBLIC_APP_STORE_REVIEW_URL=
NEXT_PUBLIC_PLAY_STORE_REVIEW_URL=
