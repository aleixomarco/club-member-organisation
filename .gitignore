# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
tsconfig.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
supabase/.temp/

# Android: lokaler SDK-Pfad, gehört nicht ins Repository
android/local.properties
# Android-Signierung: Schlüssel und Passwörter gehören nie ins Repository
android/keystore.properties
*.jks
*.keystore

# Geheimnisse, die beim Einrichten von Push im Ordner landen koennen.
# Der APNs-Schluessel und das Firebase-Dienstkonto sind private Schluessel:
# Wer sie hat, kann im Namen der App Mitteilungen verschicken. Sie gehoeren in
# den Passwortmanager und als Supabase-Geheimnis hinterlegt - niemals ins Git.
*.p8
AuthKey_*
*service-account*.json
*serviceAccount*.json
