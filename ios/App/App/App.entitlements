<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ohne diesen Eintrag scheitert PushNotifications.register() auf jedem echten
	     Geraet mit "no valid aps-environment entitlement string found". Der Upload
	     laeuft trotzdem durch und die App startet normal - es kommt nur nie eine
	     Push-Nachricht an. Beim Archivieren fuer den App Store ersetzt Xcode den
	     Wert anhand des Provisioning-Profils durch "production". -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: Ein Einladungslink auf diese Domain oeffnet die App,
	     statt den Browser. Ohne diesen Eintrag ignoriert iOS die Datei
	     .well-known/apple-app-site-association vollstaendig - der Link landet
	     dann weiter in Safari.
	     Die Domain muss die sein, die auch capacitor.config.ts laedt. Zieht die
	     App je auf eine eigene Domain um, gehoert sie zusaetzlich hierher; iOS
	     prueft jede Zeile einzeln.
	     "applinks:" ohne Schema und ohne Pfad - der Pfad steht in der Datei auf
	     dem Server, nicht hier. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:club-member-organisation.vercel.app</string>
	</array>
</dict>
</plist>
